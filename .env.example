# Copy this file to .env and add your own Gemini API key.
GEMINI_API_KEY=your_key_here
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001

# API settings
# Comma-separated exact frontend origins (scheme + host + port). '*' is ignored.
# Production example: CORS_ORIGINS=https://your-frontend-domain
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RETRIEVAL_TOP_K=4
# Top retrieval score below this is treated as a knowledge-base gap.
MIN_RETRIEVAL_SCORE=0.35
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_MAX_ENTRIES=500

# Bound each Gemini request and avoid long automatic retry chains.
GEMINI_HTTP_TIMEOUT_MS=120000
GEMINI_RETRY_ATTEMPTS=1
GEMINI_THINKING_LEVEL=low

# Enable Gemini Google Search grounding alongside local retrieval (may incur API usage charges).
GEMINI_GOOGLE_SEARCH=true
